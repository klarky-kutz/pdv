Options -Indexes
# php_value short_open_tag 0
AddType application/x-font-ttf .ttf

# 3. Set max upload file size. Most hosts will limit this and not allow it to be overridden but you can try
# php_value upload_max_filesize 999M

# 4. set max post size. uncomment this line if you have a lot of product options or are getting errors where forms are not saving all fields
# php_value post_max_size 999M

# 5. set max time script can take. uncomment this line if you have a lot of product options or are getting errors where forms are not saving all fields
# php_value max_execution_time 200

# 6. set max time for input to be recieved. Uncomment this line if you have a lot of product options or are getting errors where forms are not saving all fields
# php_value max_input_time 200

# 7. set max time for execution
# php_value max_execution_time 600

# 8. disable open_basedir limitations
# php_admin_value open_basedir none


# ==============================
# URLs amigáveis para o painel da Conta
# ==============================

RewriteEngine On

# Passar cabeçalho Authorization para o PHP (XAMPP/Apache)
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# ==============================
# DETECÇÃO AUTOMÁTICA DE AMBIENTE
# ==============================
# O Apache define automaticamente o diretório base relativo ao .htaccess
# Não precisa de RewriteBase explícito quando as regras são relativas

# Não reescreve se for arquivo ou diretório físico
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ==============================
# ROTAS - Funciona em PRODUÇÃO e LOCAL
# ==============================

# Gerenciar lojas
RewriteRule ^conta/lojas/?$ store_select.php?section=stores [L,QSA]

# Configurações da loja (UI)
RewriteRule ^conta/lojas/configuracoes/?$ store_select.php?section=store_settings [L,QSA]

# Painel da conta (visão geral)
RewriteRule ^conta/?$ store_select.php?section=overview [L,QSA]

# Assinatura & Planos
RewriteRule ^conta/planos/?$ store_select.php?section=plans&tab=plano_atual [L,QSA]
RewriteRule ^conta/planos/([^/]+)/?$ store_select.php?section=plans&tab=$1 [L,QSA]

# Usuários da conta
RewriteRule ^conta/usuarios/?$ store_select.php?section=users&tab=usuarios [L,QSA]
RewriteRule ^conta/usuarios/([^/]+)/?$ store_select.php?section=users&tab=$1 [L,QSA]

# Relatórios consolidados
RewriteRule ^conta/relatorios/?$ store_select.php?section=reports&tab=vendas [L,QSA]
RewriteRule ^conta/relatorios/([^/]+)/?$ store_select.php?section=reports&tab=$1 [L,QSA]

# Suporte (Tickets)
RewriteRule ^conta/suporte/?$ store_select.php?section=support [L,QSA]
RewriteRule ^conta/suporte/ticket/?$ store_select.php?section=support_ticket [L,QSA]
